<div class="card">
    <h2>Session Configuration</h2>
    <div class="toggle-group">
        <label class="toggle-item">
            <input type="checkbox" id="cfg-rand-q"> Randomize Questions
        </label>
        <label class="toggle-item">
            <input type="checkbox" id="cfg-rand-a"> Randomize Options
        </label>
        <label class="toggle-item">
            <input type="radio" name="cfg-feedback" value="per-q" checked> Show Answer Per Question
        </label>
        <label class="toggle-item">
            <input type="radio" name="cfg-feedback" value="end"> Show Answers At the End
        </label>
    </div>
</div>