<!--quiz-list.njk-->
<div>
    <div class="card">
        <h2>Available Practice Quizzes</h2>
        <div id="quiz-list-target">
            <p style="color: var(--text-muted); text-align: center; padding: 1rem;">
                Loading...
            </p>
        </div>
    </div>
</div>

<template id="card-template">
    <div class="quiz-item">
    <div>
        <!-- JS will target these classes to inject text safely -->
        <strong class="quiz-title"></strong><br>
        <small class="quiz-date" style="color: var(--text-muted);"></small>
    </div>
    <div class="quiz-actions">
        <!-- JS will target these classes to attach click events -->
        <button class="btn-start">Launch</button>
        <button class="btn-delete">Delete</button>
    </div>
</div>
</template>

<template id="delete-confirm">
    <div class="confirm-overlay">
        <div class="confirm-dialog">
            <h3>Confirm Delete</h3>
            <p class="confirm-message">Are you sure you want to delete this quiz?</p>
            <div class="confirm-actions">
                <button type="button" class="btn-cancel">Cancel</button>
                <button type="button" class="btn-confirm-delete">Delete</button>
            </div>
        </div>
    </div>
</template>

<template id="no-card">
    <p style="color: var(--text-muted); text-align: center; padding: 1rem;">
        No quizzes found in database. Upload a file to get started!
    </p>
</template>

<template id="connect-error">
    <p style="color: var(--incorrect);">
        Failed to connect to backend server framework.
    </p>
</template>